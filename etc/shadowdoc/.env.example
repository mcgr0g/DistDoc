# ShadowDoc: параметры подключения к прод-Trino (эмулятор по умолчанию — локальный
# lc-кластер на хосте, порт 8080). Скопируйте нужные строки в корневой .env проекта
# (mise подхватывает его автоматически) или экспортируйте перед mise run sd-*.
# Последний слог URL — УДАЛЁННЫЙ каталог (lakehouse). Локальное имя каталога в SQL
# на shadow всегда `remote` (файл catalog/remote.properties) — REMOTE_CATALOG в SQL не используется.
REMOTE_TRINO_URL=jdbc:trino://host.docker.internal:8080/lakehouse
REMOTE_USER=admin
# LDAP/basic: пароль. OAuth2: accessToken добавляется в REMOTE_TRINO_URL (?accessToken=...).
REMOTE_PASSWORD=
REMOTE_SCHEMA=default
REMOTE_TABLE=crm_combined
SHADOW_PORT=8081
# true  -> копия rx-data (.rx.json) сохраняется в etc/shadowdoc/data/<REMOTE_TABLE>-<ГГГГммдд-ЧЧММСС>.rx.json
#          (имя файла = имя таблицы источника; bind-mount, переживает sd-dn). Формат — rx-data (docs/contracts/rx-data-contract.md).
#          Таблицы Trino ВСЕГДА in-memory (memory connector) и при рестарте НЕ восстанавливаются.
# false -> отчёт только в build/dev-lakehouse/schema/shadow.rx.json
SHADOW_PERSIST=false
